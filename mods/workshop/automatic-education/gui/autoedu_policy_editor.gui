types autoedu_policy_editor_types {
  type autoedu_editor_dropdown = dropDown {
    size = { 320 33 }
    block "dropdown_data" {}

    active_item = {
      widget = {
        block "dropdown_active_widget" { name = "autoedu_editor_active_item" }
        size = { 320 33 }
        alwaystransparent = no

        state = {
          name = autoedu_editor_commit_selection
          duration = 0
          on_start = "[GetScriptedGui(Concatenate('autoedu_editor_set_', Scope.GetFlagName)).Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        }

        button_drop = {
          size = { 320 33 }
          button_trigger = none
          block "dropdown_active_text" {
            text = "[Localize(Concatenate('autoedu_editor_', Scope.GetFlagName))]"
          }
        }
      }
    }

    item = {
      widget = {
        size = { 310 30 }
        alwaystransparent = no

        button_normal = {
          size = { 100% 30 }
          button_trigger = none
          gfxtype = framedbuttongfx
          effectname = "NoHighlight"
          shaderfile = "gfx/FX/pdxgui_pushbutton.shader"
          upframe = 1
          overframe = 2
          downframe = 3
          disableframe = 1
          texture = "gfx/interface/buttons/button_interaction_menu.dds"
          framesize = { 317 30 }
        }

        button_dropdown = {
          size = { 310 30 }
          button_trigger = none
          block "dropdown_item_text" {
            text = "[Localize(Concatenate('autoedu_editor_', Scope.GetFlagName))]"
          }
          default_format = "#clickable"
        }
      }
    }

    list = {
      scrollarea = {
        position = { 5 33 }
        maximumsize = { 310 250 }
        autoresizescrollarea = yes
        scrollbarpolicy_horizontal = always_off
        scrollbar_vertical = {
          using = Scrollbar_Vertical
        }
        using = Background_DropDown
        scrollwidget = { dynamicgridbox = { alwaystransparent = no } }
      }
    }
  }
}

window = {
  name = "autoedu_policy_editor_root"
  size = { 920 760 }
  parentanchor = center
  using = Window_Background_Subwindow
  layer = top
  movable = yes
  visible = "[And(Or(GetPlayer.MakeScope.Var('autoedu_editor_ui_open').IsSet, GetVariableSystem.Exists('autoedu_editor_prewarm')), Not(IsPauseMenuShown))]"
  alpha = "[Select_float(GetVariableSystem.Exists('autoedu_editor_prewarm'), '(float)0', '(float)1')]"
  oncreate = "[GetVariableSystem.Set('autoedu_editor_prewarm', '1')]"
  state = { name = autoedu_editor_prewarm_done trigger_on_create = yes duration = 0 delay = 0.3 on_finish = "[GetVariableSystem.Clear('autoedu_editor_prewarm')]" }
  state = { name = _show using = Animation_FadeIn_Quick }
  state = { name = _hide using = Animation_FadeOut_Quick }
  vbox = {
    layoutpolicy_horizontal = expanding
    layoutpolicy_vertical = expanding
    header_pattern = {
      layoutpolicy_horizontal = expanding
      blockoverride "header_text" { text = autoedu_editor_title }
      blockoverride "button_close" { onclick = "[GetScriptedGui('autoedu_editor_ui_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
    }
    hbox = {
      layoutpolicy_horizontal = expanding margin = { 14 7 } spacing = 7
      button_standard_small = { layoutpolicy_horizontal = expanding text = autoedu_editor_tab_policies onclick = "[GetScriptedGui('autoedu_editor_set_tab_policies').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
      button_standard_small = { layoutpolicy_horizontal = expanding text = autoedu_editor_tab_general onclick = "[GetScriptedGui('autoedu_editor_set_tab_general').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
    }
    divider = { layoutpolicy_horizontal = expanding }
    vbox = {
      layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
      hbox = {
        visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('autoedu_editor_ui_tab').GetValue, '(CFixedPoint)0')]"
        layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
        widget = {
          name = "autoedu_editor_policy_sidebar" size = { 250 0 } layoutpolicy_vertical = expanding
          vbox = {
            layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding margin = { 12 12 }
            text_single = { layoutpolicy_horizontal = expanding size = { 226 30 } text = autoedu_editor_policy_list_header autoresize = no align = center }
            expand = {}
            vbox = { layoutpolicy_horizontal = expanding spacing = 8
              hbox = {
                layoutpolicy_horizontal = expanding size = { 226 34 } spacing = 8
                text_single = {
                  text = "[SelectLocalization(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('autoedu_editor_policy_0_enabled').GetValue, '(CFixedPoint)1'), 'autoedu_editor_slot_enabled', 'autoedu_editor_slot_disabled')]"
                  size = { 16 34 } autoresize = no align = center|nobaseline
                }
                button_standard = {
                  layoutpolicy_horizontal = expanding size = { 202 34 } text = autoedu_editor_policy_name_0 tooltip = autoedu_editor_policy_scope_tt_0
                  onclick = "[GetScriptedGui('autoedu_editor_select_policy_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                  down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('autoedu_editor_selected_policy').GetValue, '(CFixedPoint)0')]"
                }
              }
              hbox = {
                layoutpolicy_horizontal = expanding size = { 226 34 } spacing = 8
                text_single = {
                  text = "[SelectLocalization(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('autoedu_editor_policy_1_enabled').GetValue, '(CFixedPoint)1'), 'autoedu_editor_slot_enabled', 'autoedu_editor_slot_disabled')]"
                  size = { 16 34 } autoresize = no align = center|nobaseline
                }
                button_standard = {
                  layoutpolicy_horizontal = expanding size = { 202 34 } text = autoedu_editor_policy_name_1 tooltip = autoedu_editor_policy_scope_tt_1
                  onclick = "[GetScriptedGui('autoedu_editor_select_policy_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                  down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('autoedu_editor_selected_policy').GetValue, '(CFixedPoint)1')]"
                }
              }
              hbox = {
                layoutpolicy_horizontal = expanding size = { 226 34 } spacing = 8
                text_single = {
                  text = "[SelectLocalization(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('autoedu_editor_policy_2_enabled').GetValue, '(CFixedPoint)1'), 'autoedu_editor_slot_enabled', 'autoedu_editor_slot_disabled')]"
                  size = { 16 34 } autoresize = no align = center|nobaseline
