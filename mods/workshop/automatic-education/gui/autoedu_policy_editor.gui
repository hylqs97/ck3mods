          }
        }
        divider = { layoutpolicy_vertical = expanding }
        scrollbox = {
          layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
          blockoverride "scrollbox_content" { vbox = {
          vbox = {
            visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('autoedu_editor_selected_policy').GetValue, '(CFixedPoint)0')]"
            margin = { 22 14 } spacing = 5
            text_single = { text = autoedu_editor_policy_name_0 tooltip = autoedu_editor_policy_scope_tt_0 size = { 590 32 } autoresize = no fontsize = 20 align = center }
            text_multi = { text = autoedu_editor_policy_editor_intro size = { 590 58 } autoresize = no align = center }
      hbox = {
        size = { 590 36 }
        text_single = { text = autoedu_editor_policy_enabled size = { 245 33 } autoresize = no align = left|nobaseline }
        expand = {}
        button_checkbox_label = {
          size = { 320 33 }
          onclick = "[GetScriptedGui('autoedu_editor_toggle_policy_enabled').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
          blockoverride "checkbox" { checked = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('autoedu_editor_policy_0_enabled').GetValue, '(CFixedPoint)1')]" size = { 22 22 } parentanchor = vcenter }
          blockoverride "text" {
            text = "[SelectLocalization(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('autoedu_editor_policy_0_enabled').GetValue, '(CFixedPoint)1'), 'autoedu_editor_enabled_checkbox', 'autoedu_editor_disabled_checkbox')]"
            size = { 290 28 } autoresize = no parentanchor = vcenter align = left|nobaseline
          }
        }
      }
      button_standard_list = {
        size = { 590 38 } margin_top = 4
        onclick = "[GetScriptedGui('autoedu_editor_toggle_section_guardian').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        tooltip = autoedu_editor_section_guardian_tt
        hbox = {
          layoutpolicy_horizontal = expanding size = { 590 38 }
          margin = { 8 0 } spacing = 8
          widget = {
            size = { 24 38 }
            button_expand = {
              name = "autoedu_editor_expand_guardian"
              size = { 24 24 } parentanchor = center
              frame = "[Select_int32(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('autoedu_editor_section_guardian_open').GetValue, '(CFixedPoint)1'), '(int32)2', '(int32)1')]"
              alwaystransparent = yes
            }
          }
          widget = {
            layoutpolicy_horizontal = expanding size = { 542 38 }
            text_single = {
              layoutpolicy_horizontal = expanding size = { 542 22 } parentanchor = center
              text = autoedu_editor_section_guardian autoresize = no align = left|nobaseline fontsize = 18
              default_format = "#clickable" alwaystransparent = yes
            }
          }
        }
      }
