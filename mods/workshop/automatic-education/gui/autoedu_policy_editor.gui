                  onclick = "[GetScriptedGui('autoedu_editor_select_policy_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                  down = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('autoedu_editor_selected_policy').GetValue, '(CFixedPoint)2')]"
